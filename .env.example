# Скопируйте этот файл в .env. Никогда не добавляйте настоящий API-ключ в репозиторий.
COUNTERPARTY_LLM_MODEL=qwen3.7-plus
COUNTERPARTY_LLM_BASE_URL=https://api.dslab.tech/v1
COUNTERPARTY_LLM_API_KEY=
COUNTERPARTY_LLM_TEMPERATURE=0.1
COUNTERPARTY_LLM_MAX_TOKENS=1200
COUNTERPARTY_LLM_TIMEOUT_SECONDS=90
COUNTERPARTY_LLM_MAX_RETRIES=2
COUNTERPARTY_LLM_REASONING_ENABLED=false
COUNTERPARTY_SNAPSHOT_JSON_PATH=./data/snapshot.json
COUNTERPARTY_SNAPSHOT_CSV_PATH=
COUNTERPARTY_SESSION_DB_PATH=./data/sessions.sqlite3
COUNTERPARTY_SESSION_TTL_SECONDS=86400
COUNTERPARTY_AGENT_PATH=/agent
COUNTERPARTY_HOST=127.0.0.1
COUNTERPARTY_PORT=8000
COUNTERPARTY_LOG_LEVEL=INFO
