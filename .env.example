# Copy to .env. The key is passed only to the agent backend.
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_ID=deepseek-v4-flash
AGENT_MODEL_BASE_URL=https://api.neuraldeep.ru/v1
AGENT_MODEL_API_KEY=
AGENT_MODEL_MAX_TOKENS=4096
AGENT_RUN_TIMEOUT_SECONDS=300
# Existing local APIKEY is also accepted by Compose as a fallback.
